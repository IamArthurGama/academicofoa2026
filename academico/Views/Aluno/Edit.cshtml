@model academico.Models.Aluno

@{
    ViewData["Title"] = "Editar Aluno";
}

<h1>@ViewData["Title"]</h1>

<h4>Aluno</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AlunoId" />
            <partial name="_AlunoForm" model="Model" />

            <div class="form-group">
                <input type="submit" value="Gravar alterações" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Retornar à lista de alunos</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
